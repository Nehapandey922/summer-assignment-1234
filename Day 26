Q103. ATM Simulation
Problem Statement
Write a C program to simulate basic ATM operations.

Code
#include <stdio.h>

int main() {
    int choice;
    float balance = 10000, amount;

    printf("===== ATM MENU =====\n");
    printf("1. Check Balance\n");
    printf("2. Deposit\n");
    printf("3. Withdraw\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch(choice) {
        case 1:
            printf("Balance = %.2f\n", balance);
            break;

        case 2:
            printf("Enter amount to deposit: ");
            scanf("%f", &amount);
            balance += amount;
            printf("Updated Balance = %.2f\n", balance);
            break;

        case 3:
            printf("Enter amount to withdraw: ");
            scanf("%f", &amount);

            if(amount <= balance) {
                balance -= amount;
                printf("Updated Balance = %.2f\n", balance);
            } else {
                printf("Insufficient Balance\n");
            }
            break;

        default:
            printf("Invalid Choice");
    }

    return 0;
}

 Sample Output
