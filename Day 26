Q101. Number Guessing Game
Problem Statement
Write a C program to create a Number Guessing Game.

Code
#include <stdio.h>

int main() {
    int secret = 25, guess;

    printf("===== Number Guessing Game =====\n");

    do {
        printf("Enter your guess: ");
        scanf("%d", &guess);

        if (guess > secret)
            printf("Too High!\n");
        else if (guess < secret)
            printf("Too Low!\n");
        else
            printf("Congratulations! You guessed correctly.\n");

    } while (guess != secret);

    return 0;
}

Sample Output
