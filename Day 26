2. Deposit
3. Withdraw
Enter your choice: 3
Enter amount to withdraw: 2500
Updated Balance = 7500.00

Q104. Quiz Application
Problem Statement
Write a C program to create a simple Quiz Application.

 Code
#include <stdio.h>

int main() {
    int ans, score = 0;

    printf("===== Simple Quiz =====\n");

    printf("\n1. Capital of India?\n");
    printf("1. Mumbai\n2. Delhi\n3. Kolkata\n4. Chennai\n");
    scanf("%d", &ans);

    if(ans == 2)
        score++;

    printf("\n2. C language was developed by?\n");
    printf("1. Dennis Ritchie\n2. James Gosling\n3. Bjarne Stroustrup\n4. Guido van Rossum\n");
    scanf("%d", &ans);

    if(ans == 1)
        score++;

    printf("\nYour Score = %d/2\n", score);

    return 0;
}

