Q120 – Complete Mini Project (Student Management System)
Problem Statement
Develop a mini project using arrays, strings, structures and functions.

Code
#include <stdio.h>

struct Student
{
    int roll;
    char name[50];
    float marks;
};

void display(struct Student s[], int n)
{
    int i;

    printf("\nStudent Details\n");

    for(i=0;i<n;i++)
    {
        printf("Roll No : %d\n",s[i].roll);
        printf("Name     : %s\n",s[i].name);
        printf("Marks    : %.2f\n\n",s[i].marks);
    }
}

int main()
{
    int n=3, i;
    struct Student s[3];

    for(i=0;i<n;i++)
    {
        printf("Enter Roll, Name and Marks: ");
        scanf("%d %s %f",
              &s[i].roll,
              s[i].name,
              &s[i].marks);
    }

    display(s,n);

    return 0;
}

