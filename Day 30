Q117 – Student Record System
Problem Statement
Write a program to store and display student details using arrays and strings.

Code
#include <stdio.h>

struct Student
{
    int roll;
    char name[50];
    float marks;
};

int main()
{
    struct Student s[3];
    int i;

    for(i=0;i<3;i++)
    {
        printf("Enter Roll No, Name and Marks: ");
        scanf("%d %s %f",&s[i].roll,s[i].name,&s[i].marks);
    }

    printf("\nStudent Records\n");

    for(i=0;i<3;i++)
    {
        printf("Roll: %d\n",s[i].roll);
        printf("Name: %s\n",s[i].name);
        printf("Marks: %.2f\n\n",s[i].marks);
    }

    return 0;
}

